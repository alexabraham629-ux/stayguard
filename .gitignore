# Python / tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# Secrets — never commit a real key (.env.example is committed instead)
.env

# Data: rebuilt by `make data`; only a small sample of raw CSVs is committed
data/raw/*
!data/raw/.gitkeep
!data/raw/sample/
data/*.duckdb
data/*.duckdb.wal
# AI caches ARE committed: the public demo runs without a key (ADR-013)
!data/demo_cache.json
!data/memo_cache.json
data/exports/*
!data/exports/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code preview config
.claude/

# Playwright MCP logs and snapshots
.playwright-mcp/
